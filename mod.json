{
    "geode": "5.8.2",
    "gd": {
        "android": "2.2081"
    },
    "id": "amba.trajectorybot",
    "name": "TrajectoryBot",
    "version": "v0.3.0",
    "developer": "Amba",
    "description": "Android64 trajectory overlay and experimental autoplay controller for GD 2.2081.",
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    },
    "settings": {
        "trajectory-enabled": {
            "name": "Trajectory Overlay",
            "description": "Tampilkan prediksi trajectory saat bermain.",
            "type": "bool",
            "default": true
        },
        "bot-enabled": {
            "name": "AutoPlay",
            "description": "Aktifkan bot autoplay (practice mode aja!)",
            "type": "bool",
            "default": false
        },
        "prediction-frames": {
            "name": "Prediction Length (frames)",
            "description": "Berapa frame ke depan trajectory diprediksi.",
            "type": "int",
            "default": 60,
            "min": 10,
            "max": 240
        },
        "decision-horizon": {
            "name": "Bot Decision Horizon (frames)",
            "description": "Seberapa jauh bot melihat ke depan saat membuat keputusan.",
            "type": "int",
            "default": 30,
            "min": 5,
            "max": 120
        }
    }
}
